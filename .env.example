# ----------------------------------------------------------------------------
# solace-subber configuration
#
# Copy this file to ".env" in the current working directory (or beside the
# scripts). Lines starting with # are comments.
# ----------------------------------------------------------------------------

# --- Connection ---------------------------------------------------------------

# Broker host. Either "host:port" or a full URL with scheme.
#   plain SMF   default port 55555
#   secure SMF  default port 55443
# If you omit the scheme, it is derived from SOLACE_SECURE below.
SOLACE_HOST=192.168.1.10:55555

# Message VPN name.
SOLACE_VPN=default

# Client credentials.
SOLACE_USERNAME=admin
SOLACE_PASSWORD=admin

# Use secure SMF (TLS). true => tcps://, false => tcp://
SOLACE_SECURE=false

# When secure, validate the broker's TLS certificate.
# Default false = ignore/skip SSL validation (handy for debugging self-signed brokers).
SOLACE_SSL_VALIDATE_CERT=false

# Connection timeout (ms) and reconnect attempts.
SOLACE_CONNECT_TIMEOUT_MS=10000
SOLACE_RECONNECT_RETRIES=3

# --- Source -------------------------------------------------------------------

# Where to consume from: "topic" (direct) or "queue" (guaranteed).
SOLACE_SOURCE_TYPE=topic

# Topic subscription (used when SOLACE_SOURCE_TYPE=topic). Wildcards: * and >
SOLACE_TOPIC=my/topic/>

# Queue name (used when SOLACE_SOURCE_TYPE=queue, or as default for solace-browser).
SOLACE_QUEUE=my-queue

# Default page size for solace-browser (positive integer).
SOLACE_BROWSER_PAGE_SIZE=10

# --- Behavior -----------------------------------------------------------------

# "step"       = consume one message, then wait for Enter before the next (default).
# "continuous" = consume as fast as messages arrive.
SOLACE_CONSUME_MODE=step

# --- Output -------------------------------------------------------------------

# Console verbosity.
#   false (default) = concise block per message (ids + short payload preview).
#   true            = full metadata dump + complete untruncated payload.
SOLACE_CONSOLE_FULL=false

# Append events to a log file as NDJSON (one JSON object per line).
# Default true. Consumer logs every message; browser logs only on `d` (page dump).
SOLACE_LOG_TO_FILE=true

# Log file path. Relative paths resolve against the current working directory.
SOLACE_LOG_FILE=solace-events.log
