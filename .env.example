# ----------------------------------------------------------------------------
# solace-subber configuration
#
# Copy this file to ".env" in the current working directory (or beside the
# scripts). Or pass -e / --env with a path or short name: -e dev loads
# .env.dev (cwd, then beside the scripts). Relative paths are from the
# current working directory.
# Lines starting with # are comments.
# ----------------------------------------------------------------------------

# --- Connection ---------------------------------------------------------------

# Broker host. Either "host:port" or a full URL with scheme.
#   plain SMF   default port 55555
#   secure SMF  default port 55443
# If you omit the scheme, it is derived from SOLACE_SECURE below.
SOLACE_HOST=192.168.1.10:55555

# Message VPN name.
SOLACE_VPN=default

# Client credentials.
SOLACE_USERNAME=admin
SOLACE_PASSWORD=admin

# Use secure SMF (TLS). true => tcps://, false => tcp://
SOLACE_SECURE=false

# When secure, validate the broker's TLS certificate.
# Default false = ignore/skip SSL validation (handy for debugging self-signed brokers).
SOLACE_SSL_VALIDATE_CERT=false

# Connection timeout (ms) and reconnect attempts.
SOLACE_CONNECT_TIMEOUT_MS=10000
SOLACE_RECONNECT_RETRIES=3

# --- Source (consumer / browser) ---------------------------------------------

# Consume source type: "topic" or "queue".
SOLACE_SOURCE_TYPE=topic

# Consume topic(s). Comma-separated list allowed (e.g. a/b, c/d/>, e/*/f).
# Falls back to legacy SOLACE_TOPIC if unset.
SOLACE_SOURCE_TOPIC=my/topic/>

# Consume / browse default queue. Falls back to legacy SOLACE_QUEUE if unset.
SOLACE_SOURCE_QUEUE=my-queue

# Default page size for browser.py (positive integer).
SOLACE_BROWSER_PAGE_SIZE=10

# --- Destination (publisher / xfer) ------------------------------------------

# Publisher and xfer dest type: "topic" or "queue".
# Falls back to SOLACE_SOURCE_TYPE if unset.
SOLACE_DEST_TYPE=topic

# Publisher / xfer topic. Falls back to legacy SOLACE_TOPIC if unset.
SOLACE_DEST_TOPIC=my/topic/>

# Publisher / xfer queue. Falls back to legacy SOLACE_QUEUE if unset.
SOLACE_DEST_QUEUE=my-queue

# Legacy aliases (used only when the SOURCE_/DEST_ keys above are unset):
# SOLACE_TOPIC=my/topic/>
# SOLACE_QUEUE=my-queue

# --- Behavior -----------------------------------------------------------------

# Startup wizard (dest type, queue/topic, mode, start-gate, xfer confirms).
# Default true. Set false for kube/unattended: take values from env (and CLI
# where they exist) and proceed.
# Does not affect browser.py (always prompts Queue? / Page size? and the command loop).
SOLACE_INTERACTIVE=true

# --- Behavior (consume / publish) --------------------------------------------

# Default consume mode when SOLACE_CONSUME_MODE is unset:
#   queue  → step
#   topic  → continuous
# Set explicitly to override the destination-based default:
# "step"       = consume one message, then wait for Enter before the next.
#                (In topic mode, messages arriving while paused are dropped.
#                 In queue mode, stepping is loss-less: one unacked at a time.)
# "continuous" = consume as fast as messages arrive.
# When SOLACE_INTERACTIVE=false, step is ignored (treated as continuous).
# SOLACE_CONSUME_MODE=step

# On session reconnect while consuming:
#   seamless (default) = keep current mode; re-subscribe / rebind and continue
#   stop               = cancel consume (interactive: return to mode menu;
#                        non-interactive: exit with error)
SOLACE_RECONNECT_MODE=seamless

# Publisher delivery mode (publisher.py).
#   auto        = Direct for topic, Persistent for queue (default when unset)
#   direct      = Direct messaging
#   persistent  = Guaranteed / Persistent (needed for direct-to-queue)
SOLACE_DELIVERY_MODE=auto

# Non-interactive publisher only (ignored when SOLACE_INTERACTIVE=true).
# Number of messages to send then exit. Each payload is a unique UTC ISO-8601
# timestamp with milliseconds (e.g. 2026-11-02T03:21:00.123Z). Must be >= 1.
SOLACE_PUBLISH_COUNT=1

# --- Output -------------------------------------------------------------------

# Console verbosity.
#   false (default) = concise block per message (ids + short payload preview).
#   true            = full metadata dump + complete untruncated payload.
SOLACE_CONSOLE_FULL=false

# Append events to a log file. Default true.
# Consumer logs every message; browser logs on `d` (page dump) and `a` (dump-all).
SOLACE_LOG_TO_FILE=true

# Log file path. Relative paths resolve against the current working directory.
SOLACE_LOG_FILE=solace-events.log

# Log line format (default full).
#   full         (alias ndjson)                          = NDJSON: one JSON object per line, metadata + full payload.
#   simple       (alias compact)                         = [{timestamp}]::[{topic}]::{payload}
#   payload_only (aliases payload / payload-only / body) = payload only (UTF-8; no timestamp/topic/JSON)
#     timestamp = broker sender/receiver UTC when available, else local receive time with offset.
#     payload   = full UTF-8; newlines/CRs escaped as \n / \r (one physical line, no truncation).
SOLACE_LOG_FORMAT=full

# Warn at startup when an existing events log is at least this large (MiB).
# Set to 0 to disable. Override with SOLACE_LOG_WARN_BYTES for an exact byte size.
SOLACE_LOG_WARN_MB=50

# --- solace-xfer --------------------------------------------------------------
# Required when SOLACE_INTERACTIVE=false: sender or receiver.
# SOLACE_XFER_ROLE=sender

# File-transfer chunk size in bytes (binary payload per DATA message).
# Default 1048576 (1 MiB) — safer than the common Solace max payload of 10_000_000.
# Must be 1..10000000; values above 10000000 are rejected at startup / prompt.
# SOLACE_XFER_CHUNK_BYTES=1048576
